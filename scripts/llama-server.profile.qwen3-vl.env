# Qwen3-VL-8B-Instruct (unsloth Q4_K_M) — image-to-text server
# Download:
#   hf download unsloth/Qwen3-VL-8B-Instruct-GGUF \
#     --include "Qwen3-VL-8B-Instruct-Q4_K_M.gguf" \
#     --include "mmproj-F16.gguf" \
#     --local-dir ~/Downloads/Qwen3-VL-8B

export LLAMA_MODEL_PATH=~/Downloads/Qwen3-VL-8B/Qwen3-VL-8B-Instruct-Q4_K_M.gguf
export LLAMA_MM_PROJ=~/Downloads/Qwen3-VL-8B/mmproj-F16.gguf
export LLAMA_CONTEXT=32768
export LLAMA_CACHE_TYPE_K=q8_0
export LLAMA_CACHE_TYPE_V=q8_0
export LLAMA_BATCH=2048
export LLAMA_UBATCH=512
export LLAMA_SPEC_TYPE=none

# Shared settings
export LLAMA_CHAT_TEMPLATE=~/scripts/chat_template.jinja
export LLAMA_PORT=8083
export LLAMA_THREADS=8
export LLAMA_GPU_LAYERS=99
export LLAMA_PARALLEL=1
export LLAMA_LOG_LEVEL=4
export LLAMA_TEMP=0.2
export LLAMA_TOP_P=0.95
export LLAMA_TOP_K=40
export LLAMA_MIN_P=0.0
export LLAMA_PRESENCE_PENALTY=0.0
export LLAMA_REPEAT_PENALTY=1.10
export LLAMA_REASONING_PRESERVE=0
export LLAMA_LOAD_MODE=mmap
export LLAMA_FLASH_ATTN=on
