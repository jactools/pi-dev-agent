# Qwen3.8-27B — Best Overall for Reasoning & Planning
# Model: unsloth/Qwen3.8-27B-GGUF
# Recommended quantizations: Q6_K (~15 GB) or UD-Q4_0 (~9 GB)
# Native support for xhigh reasoning effort, MTP (Multi-Token Prediction)
# 262K context window, strong coding performance, Apache 2.0 license
# Vision capabilities: Native support for image understanding

# Primary recommendation: UD-Q4_0 for best balance of speed/quality
# export LLAMA_MODEL_PATH=~/models/unsloth/Qwen3.8-27B-GGUF/Qwen3.8-27B-UD-Q4_0.gguf

# Alternative: Q6_K for higher quality (~15 GB)
# export LLAMA_MODEL_PATH=~/models/unsloth/Qwen3.8-27B-GGUF/Qwen3.8-27B-Q6_K.gguf

# MTP variant for faster inference (1.3-1.7x speedup)
# export LLAMA_MODEL_PATH=~/models/unsloth/Qwen3.8-27B-GGUF/Qwen3.8-27B-MTP-Q4_0.gguf

export LLAMA_MODEL_PATH=~/models/unsloth/Qwen3.8-27B-GGUF/Qwen3.8-27B-UD-Q4_0.gguf

export LLAMA_CONTEXT=262144
export LLAMA_CACHE_TYPE_K=q8_0
export LLAMA_CACHE_TYPE_V=q8_0
export LLAMA_BATCH=2048
export LLAMA_UBATCH=1024

# MTP specification for multi-token prediction support
export LLAMA_SPEC_TYPE=draft-mtp

# Shared settings
export LLAMA_CHAT_TEMPLATE=~/scripts/chat_template.jinja
export LLAMA_PORT=8080
export LLAMA_THREADS=10
export LLAMA_GPU_LAYERS=99
export LLAMA_PARALLEL=1
export LLAMA_LOG_LEVEL=4
export LLAMA_TEMP=0.5
export LLAMA_TOP_P=0.9
export LLAMA_TOP_K=40
export LLAMA_MIN_P=0.0
export LLAMA_PRESENCE_PENALTY=0.0
export LLAMA_REPEAT_PENALTY=1.2

# Enable reasoning preservation for debugging (set to 0 for production)
export LLAMA_REASONING_PRESERVE=0

# System prompt for reasoning tasks
export LLAMA_SYSTEM_PROMPT="Reasoning effort: xhigh\n\nYou are an expert planner and reasoner. Think step-by-step before answering. Use chain-of-thought reasoning to break down complex problems into manageable steps. Validate key assumptions, consider plausible alternatives, and prioritize correctness."

export LLAMA_LOAD_MODE=mmap
export LLAMA_FLASH_ATTN=on
