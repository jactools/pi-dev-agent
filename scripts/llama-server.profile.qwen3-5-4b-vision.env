# Qwen3.5-4B-Vision — Lightweight Vision Model
# Model: bjivanovich/Qwen3.5-4B-Vision-GGUF
# Recommended quantization: Q6_K (~2.7 GB) or BF16 with mmproj (~4.2 GB total)
# Native vision encoder integrated with text reasoning
# 262K context window, Apache 2.0 license
# Perfect for quick image analysis, code screenshot debugging, OCR with reasoning

# Q6_K quantization (~2.7 GB model + ~1.5 GB mmproj = ~4.2 GB total)
export LLAMA_MODEL_PATH=~/models/bjivanovich/Qwen3.5-4B-Vision-GGUF/Qwen3.5-4B-Vision-Q6_K.gguf

# Vision models require an mmproj file (projector)
export LLAMA_MM_PROJ=~/models/bjivanovich/Qwen3.5-4B-Vision-GGUF/Qwen3.5-4B-BF16-mmproj.gguf

# Large context for vision + text tasks
export LLAMA_CONTEXT=262144
export LLAMA_CACHE_TYPE_K=q8_0
export LLAMA_CACHE_TYPE_V=q8_0
export LLAMA_BATCH=512
export LLAMA_UBATCH=128
export LLAMA_SPEC_TYPE=none

# Shared settings
export LLAMA_CHAT_TEMPLATE=~/scripts/chat_template.jinja
export LLAMA_PORT=8082
export LLAMA_THREADS=4
export LLAMA_GPU_LAYERS=99
export LLAMA_PARALLEL=1
export LLAMA_LOG_LEVEL=4
export LLAMA_TEMP=0.5
export LLAMA_TOP_P=0.95
export LLAMA_TOP_K=40
export LLAMA_MIN_P=0.0
export LLAMA_PRESENCE_PENALTY=0.0
export LLAMA_REPEAT_PENALTY=1.10

# Enable reasoning preservation for debugging (set to 0 for production)
export LLAMA_REASONING_PRESERVE=0

# System prompt for vision tasks
export LLAMA_SYSTEM_PROMPT="You are a vision-capable assistant. Analyze images carefully and provide detailed, accurate descriptions. For code screenshots, identify bugs, suggest improvements, and explain concepts clearly."

export LLAMA_LOAD_MODE=mmap
export LLAMA_FLASH_ATTN=on
