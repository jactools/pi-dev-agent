# Qwen3.8-27B — Best Overall for Reasoning & Planning
# Model: unsloth/Qwen3.8-27B-GGUF
# Recommended quantizations: UD-Q4_K_M (~9-10 GB) or UD-Q6_K (~15 GB)
# Native support for xhigh reasoning effort, MTP (Multi-Token Prediction)
# 262K context window, strong coding performance, Apache 2.0 license
# Vision capabilities: Native support for image understanding

# ============================================
# DOWNLOAD COMMANDS
# ============================================
# Primary recommendation: UD-Q4_K_M (best balance of speed/quality)
# hf download unsloth/Qwen3.8-27B-GGUF \
#   --include "Qwen3.8-27B-UD-Q4_K_M.gguf" \
#   --local-dir ~/models/unsloth/Qwen3.8-27B-GGUF

# Alternative: UD-Q5_K_M (better quality)
# hf download unsloth/Qwen3.8-27B-GGUF \
#   --include "Qwen3.8-27B-UD-Q5_K_M.gguf" \
#   --local-dir ~/models/unsloth/Qwen3.8-27B-GGUF

# High quality: UD-Q6_K (maximum quality)
# hf download unsloth/Qwen3.8-27B-GGUF \
#   --include "Qwen3.8-27B-UD-Q6_K.gguf" \
#   --local-dir ~/models/unsloth/Qwen3.8-27B-GGUF

# MTP variant for faster inference (1.3-1.7x speedup)
# hf download unsloth/Qwen3.8-27B-GGUF \
#   --include "MTP/mtp-Qwen3.8-27B-Q4_0.gguf" \
#   --local-dir ~/models/unsloth/Qwen3.8-27B-GGUF
# ============================================

# Primary: UD-Q4_K_M + MTP draft module (speculative decoding, ~1.3-1.7x faster)
# Requires the mtp gguf to be downloaded first:
#   hf download unsloth/Qwen3.8-27B-GGUF \
#     --include "MTP/mtp-Qwen3.8-27B-Q4_0.gguf" \
#     --local-dir ~/models/unsloth/Qwen3.8-27B-GGUF
export LLAMA_MODEL_PATH=~/models/unsloth/Qwen3.8-27B-GGUF/Qwen3.8-27B-UD-Q4_K_M.gguf
export LLAMA_DRAFT_MODEL=~/models/unsloth/Qwen3.8-27B-GGUF/MTP/mtp-Qwen3.8-27B-Q4_0.gguf
export LLAMA_CONTEXT=80000
export LLAMA_SPEC_TYPE=draft-mtp
# Fallback without MTP (slower, no draft file needed):
# export LLAMA_DRAFT_MODEL=
# export LLAMA_SPEC_TYPE=none

# Alternative: UD-Q5_K_M for better quality (~10-11 GB)
# export LLAMA_MODEL_PATH=~/models/unsloth/Qwen3.8-27B-GGUF/Qwen3.8-27B-UD-Q5_K_M.gguf
# export LLAMA_SPEC_TYPE=none

# High quality: UD-Q6_K for maximum quality (~15 GB)
# export LLAMA_MODEL_PATH=~/models/unsloth/Qwen3.8-27B-GGUF/Qwen3.8-27B-UD-Q6_K.gguf

# MTP is enabled via LLAMA_DRAFT_MODEL + LLAMA_SPEC_TYPE above (do NOT set the mtp file as MODEL_PATH)

# Default: UD-Q4_K_M (best balance)
# export LLAMA_MODEL_PATH=~/models/unsloth/Qwen3.8-27B-GGUF/Qwen3.8-27B-UD-Q4_K_M.gguf
#export LLAMA_CONTEXT=262144

export LLAMA_CACHE_TYPE_K=q8_0
export LLAMA_CACHE_TYPE_V=q8_0
export LLAMA_BATCH=2048
export LLAMA_UBATCH=1024

# export LLAMA_SPEC_TYPE=none

# Shared settings
export LLAMA_CHAT_TEMPLATE=~/scripts/chat_template.jinja
export LLAMA_PORT=1234
export LLAMA_THREADS=10
export LLAMA_GPU_LAYERS=99
export LLAMA_PARALLEL=1
export LLAMA_LOG_LEVEL=4
export LLAMA_TEMP=0.5
export LLAMA_TOP_P=0.9
export LLAMA_TOP_K=40
export LLAMA_MIN_P=0.0
export LLAMA_PRESENCE_PENALTY=0.0
export LLAMA_REPEAT_PENALTY=1.2

# Enable reasoning preservation for debugging (set to 0 for production)
export LLAMA_REASONING_PRESERVE=0

# System prompt for reasoning tasks
export LLAMA_SYSTEM_PROMPT="Reasoning effort: xhigh\n\nYou are an expert planner and reasoner. Think step-by-step before answering. Use chain-of-thought reasoning to break down complex problems into manageable steps. Validate key assumptions, consider plausible alternatives, and prioritize correctness."

export LLAMA_LOAD_MODE=mmap
export LLAMA_FLASH_ATTN=on

# Disable automatic memory fitting for stability
# export LLAMA_FIT=0
