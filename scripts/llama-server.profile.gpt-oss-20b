# gpt-oss-20B — Best for Agentic Workflows
# Model: unsloth/gpt-oss-20b-GGUF
# Recommended quantizations: MXFP4 (~13.8 GB) or Q6_K (~15 GB)
# Native reasoning support, Python execution, web browsing, structured output
# 131K context window, Apache 2.0 license
# Built from the ground up for agentic tasks with configurable reasoning effort

# Primary recommendation: MXFP4 for best balance of speed/quality
# export LLAMA_MODEL_PATH=~/models/unsloth/gpt-oss-20b-GGUF/gpt-oss-20b-MXFP4.gguf

# Alternative: Q6_K for higher quality (~15 GB)
# export LLAMA_MODEL_PATH=~/models/unsloth/gpt-oss-20b-GGUF/gpt-oss-20b-Q6_K.gguf

export LLAMA_MODEL_PATH=~/models/unsloth/gpt-oss-20b-GGUF/gpt-oss-20b-MXFP4.gguf

export LLAMA_CONTEXT=131072
export LLAMA_CACHE_TYPE_K=q8_0
export LLAMA_CACHE_TYPE_V=q8_0
export LLAMA_BATCH=2048
export LLAMA_UBATCH=1024

# MXFP4 requires mmproj-format
# Note: The MXFP4 model file includes the projector internally
export LLAMA_SPEC_TYPE=none

# Shared settings
export LLAMA_CHAT_TEMPLATE=~/scripts/chat_template.jinja
export LLAMA_PORT=8081
export LLAMA_THREADS=10
export LLAMA_GPU_LAYERS=99
export LLAMA_PARALLEL=1
export LLAMA_LOG_LEVEL=4
export LLAMA_TEMP=0.5
export LLAMA_TOP_P=0.9
export LLAMA_TOP_K=40
export LLAMA_MIN_P=0.0
export LLAMA_PRESENCE_PENALTY=0.0
export LLAMA_REPEAT_PENALTY=1.2

# Enable reasoning preservation for debugging (set to 0 for production)
export LLAMA_REASONING_PRESERVE=0

# System prompt for agentic workflows with high reasoning
export LLAMA_SYSTEM_PROMPT="Reasoning: high\n\nYou are a helpful assistant with native tool integration capabilities. You can execute Python code, browse the web, and produce structured outputs. Always think through complex problems step-by-step before providing answers."

export LLAMA_LOAD_MODE=mmap
export LLAMA_FLASH_ATTN=on
