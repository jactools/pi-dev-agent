# export LLAMA_CACHE_TYPE_K=q4_0
# export LLAMA_CACHE_TYPE_V=q4_0
export LLAMA_CHAT_TEMPLATE=~/scripts/chat_template.jinja
# Should be set in shell profile:
#export LLAMA_CPP_ROOT=~/llama.cpp
export LLAMA_PORT=1234
export LLAMA_THREADS=4
export LLAMA_GPU_LAYERS=30
export LLAMA_PARALLEL=1
export LLAMA_LOG_LEVEL=4
export LLAMA_TEMP=0.2
export LLAMA_TOP_P=0.95
export LLAMA_TOP_K=40
export LLAMA_MIN_P=0.0
export LLAMA_PRESENCE_PENALTY=0.0
export LLAMA_REPEAT_PENALTY=1.10
# export LLAMA_SPEC_TYPE=draft-mtp
# export LLAMA_SPEC_TYPE=none
# Preserving the full reasoning trace grows active context quickly and can
# materially reduce generation speed on long-running chats.
export LLAMA_REASONING_PRESERVE=0
export LLAMA_LOAD_MODE=mmap
export LLAMA_FLASH_ATTN=on
