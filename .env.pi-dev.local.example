# Local environment for the pi-dev agent container.

PI_DEV_BASE_IMAGE_NAME=platform-pi-dev-base
PI_DEV_AGENT_IMAGE_NAME=platform-pi-dev-agent
PI_DEV_IMAGE_TAG=latest
PI_CODING_AGENT_VERSION=latest

# Required host bind mounts.
GITREPOS_HOST_PATH=/absolute/path/to/gitrepos
PI_CONFIG_HOST_PATH=/absolute/path/to/.pi

# Optional SSH support for reaching remote hosts from inside the container.
# Set this to your host .ssh directory to expose all recognizable public key
# files inside the container without exposing private keys.
# When unset, compose mounts an empty managed volume at /mnt/host-ssh and no
# public keys are linked into /home/app_user/.ssh.
# SSH_DIR_HOST_PATH=/absolute/path/to/.ssh

# Optional HTTP proxy settings for the pi-dev agent sidecar proxy.
# The blocked hostname/domain list lives in docker/pi-dev-agent/proxy/blocked_domains.txt.
PI_DEV_AGENT_PROXY_PORT=3128
PI_DEV_AGENT_NO_PROXY=localhost,127.0.0.1,host.docker.internal,.local,.svc,.svc.cluster.local,.dev.jac.dot

# Optional port override for the pi HTTP interface.
PI_DEV_AGENT_PORT=3000