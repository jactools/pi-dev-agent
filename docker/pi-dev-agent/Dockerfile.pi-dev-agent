# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE=platform-pi-dev-base:latest
FROM ${BASE_IMAGE}
ARG TARGETARCH

ARG PI_CODING_AGENT_VERSION=latest
ARG PLAYWRIGHT_VERSION=1.62.1
ARG INSTALL_PLAYWRIGHT=true

ENV WORKSPACE_ROOT=/workspace \
    GITREPOS_DIR=/workspace/gitrepos \
    PI_CONFIG_DIR=/home/app_user/.pi \
    NODE_PATH=/usr/local/lib/node_modules \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY docker/pi-dev-agent/entrypoint.sh /usr/local/bin/pi-dev-entrypoint.sh
COPY docker/pi-dev-agent/pi-wrapper.sh /usr/local/pi-dev/bin/pi
RUN chmod +x /usr/local/pi-dev/bin/pi

# Container models.json: the repo template already uses the tunnel sidecar service
# names (tunnel-local-llm / tunnel-mini-ai), which resolve via compose DNS inside the
# container and via 127.0.0.1 /etc/hosts entries on the Mac host — one config for both.
# Kept in a staging dir (outside the config volume) and seeded into the agent dir on
# first run by the entrypoint. The host's ~/.pi/agent/models.json is never modified.
COPY pi/agent/models.json /usr/local/pi-dev/agent/models.json

# Container-specific settings.json: default pi settings for the agent container.
# Seeded into the agent dir on first run (no-op if already present).
COPY pi/agent/settings.json /usr/local/pi-dev/settings.template.json

# Create the shared Python venv (empty). No packages are installed at build time:
# there are no credentials in the build environment and all resolution must go
# through the jacloud.site private index, which the entrypoint configures from
# env vars on container start. The entrypoint then populates the venv with every
# requirements*.txt / pyproject package found under /workspace/gitrepos plus a
# pinned set of core test packages and utilities (including python-pptx).
ENV VIRTUAL_ENV=/workspace/.venv
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

RUN python3 -m venv "$VIRTUAL_ENV" \
 && "$VIRTUAL_ENV/bin/python" -c 'import sys; assert sys.version_info[:2] == (3, 13), sys.version' \
 && ln -sf "$VIRTUAL_ENV/bin/pip3" /usr/local/bin/pip-venv-test \
 && printf '#!/bin/sh\nexec %s/bin/python3 "$@"\n' "$VIRTUAL_ENV" > /usr/local/bin/python-venv-test \
 && chmod +x /usr/local/bin/python-venv-test \
 && mkdir -p /home/app_user/.config/pip

# Upgrade npm
RUN --mount=type=secret,id=npmrc \
    if [ -f /run/secrets/npmrc ]; then export NPM_CONFIG_USERCONFIG=/run/secrets/npmrc; fi \
 && npm install -g npm@latest

# Install global packages separately for better error isolation
RUN --mount=type=secret,id=npmrc,required=false \
    if [ -f /run/secrets/npmrc ]; then export NPM_CONFIG_USERCONFIG=/run/secrets/npmrc; fi \
 && cd /tmp && npm install -g "@earendil-works/pi-coding-agent"

RUN --mount=type=secret,id=npmrc,required=false \
    if [ -f /run/secrets/npmrc ]; then export NPM_CONFIG_USERCONFIG=/run/secrets/npmrc; fi \
 && cd /tmp && npm install -g "@mermaid-js/mermaid-cli"

# Install Playwright and Chromium only when enabled (disabled for corporate builds).
RUN --mount=type=secret,id=npmrc,required=false \
    if [ "$INSTALL_PLAYWRIGHT" = "true" ]; then \
      if [ -f /run/secrets/npmrc ]; then export NPM_CONFIG_USERCONFIG=/run/secrets/npmrc; fi && \
      cd /tmp && npm install -g playwright@${PLAYWRIGHT_VERSION} && \
      npx playwright install --with-deps chromium; \
    else \
      echo "Skipping Playwright and Chromium installation"; \
    fi

# Install shellcheck via apt
RUN apt-get install -y --no-install-recommends shellcheck

# libpq5: psycopg 3.x is a pure-Python driver that loads libpq via ctypes at
# runtime, so the shared library must be present in the image for the shared venv.
RUN --mount=type=cache,id=pi-dev-moody-apt-archives-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=pi-dev-moody-apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    apt-get -o Acquire::Languages=none -o APT::Update::Error-Mode=any update && \
    apt-get install -y --no-install-recommends libpq5

# The moody-ai base image ships with git. The agent must not have VCS access:
# only explicitly configured repos are bind-mounted (see GITREPOS_ALLOWLIST in
# scripts/pi_dev_agent.sh) and egress to code hosts is denied by the squid sidecar.
# Purge the package, sweep any leftovers, and fail the build if git survives.
RUN --mount=type=cache,id=pi-dev-moody-apt-archives-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=pi-dev-moody-apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    apt-get -o Acquire::Languages=none update && \
    apt-get purge -y git git-man && \
    rm -rf /usr/lib/git-core && \
    if command -v git >/dev/null 2>&1; then echo "ERROR: git is still present in the image" >&2; exit 1; fi

# The agent must not be able to install packages at runtime: with apt-get left
# in place it could simply reinstall the purged git (or anything else). Remove
# the package manager frontends and dpkg itself, then fail the build if any of
# them survive. Nothing at runtime needs a package manager: the entrypoint only
# uses pip (jacloud.site index), curl, iptables, and su.
# PATH is scanned explicitly (not via `command -v`) so a stale shell hash
# table can never mask a leftover binary. IFS must be set to ':' for the split.
RUN rm -f /usr/bin/apt /usr/bin/apt-get /usr/bin/dpkg \
 && { save_ifs="$IFS"; IFS=':'; set -- ${PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}; IFS="$save_ifs"; \
      for d in "$@"; do \
        for c in apt apt-get dpkg; do \
          if [ -e "$d/$c" ]; then echo "ERROR: package manager still present in the image: $d/$c" >&2; exit 1; fi; \
        done; \
      done; }

# WeKan backlog skill, baked at USER level so pi discovers it from any CWD.
# Project-level .agents/skills cannot work here: the pi-dev-agent repo itself must
# never be mounted into its own container (see scripts/pi_dev_agent.sh), and only
# allowlisted repos are bind-mounted under /workspace/gitrepos.
# Placed after all heavy install layers on purpose: these copies have no build-time
# dependencies, so editing the skill/config must not invalidate the npm/playwright cache.
COPY .agents/skills/wekan-backlog/ /home/app_user/.agents/skills/wekan-backlog/

# Container WeKan config: the repo's .wekan-backlog-config.json with ca_cert rewritten
# to an absolute in-container path (relative paths resolve against the config file's
# directory, and ~/.config is not a sibling of platform-foundation). wekan.sh finds it
# from any CWD (~/.config/wekan-backlog/config.json); a per-repo .wekan-backlog-config.json
# or $WEKAN_CONFIG_PATH still takes precedence. Board changes require an image rebuild.
COPY .wekan-backlog-config.json /usr/local/pi-dev/wekan-backlog-config.template.json
RUN mkdir -p /home/app_user/.config/wekan-backlog \
 && jq '.ca_cert = "/workspace/gitrepos/platform-foundation/certs/dev/platform-dev-rootCA.pem"' \
      /usr/local/pi-dev/wekan-backlog-config.template.json \
    > /home/app_user/.config/wekan-backlog/config.json \
 && chown -R app_user:app_user /home/app_user/.agents /home/app_user/.config/wekan-backlog

# ── Moody-AI bundle (git submodule at vendor/moody-ai) ───────────────────────
# Skills, personas/prompts, subagent rules and pi extensions from the moody-ai repo.
# The submodule pin is the single source of truth: bump it there to update this
# image. release-moody-ai is intentionally NOT included — it cuts releases against
# a live dev container and needs git, which this image purges on purpose.
#
# Skills land USER-level (~/.agents/skills) so pi discovers them from any CWD,
# same rationale as the wekan skill above. first-time-setup is included: it only
# acts when the document store is up with ZERO collections and stops otherwise.
COPY vendor/moody-ai/.pi/skills/first-time-setup /home/app_user/.agents/skills/first-time-setup
COPY vendor/moody-ai/.pi/skills/seed-document-store /home/app_user/.agents/skills/seed-document-store
COPY vendor/moody-ai/.pi/skills/review-topic /home/app_user/.agents/skills/review-topic
COPY vendor/moody-ai/.pi/skills/workspace-options /home/app_user/.agents/skills/workspace-options
COPY vendor/moody-ai/.pi/skills/plan /home/app_user/.agents/skills/plan
COPY vendor/moody-ai/.pi/skills/archive-plans /home/app_user/.agents/skills/archive-plans

# Personas/prompts + subagent rules: staged OUTSIDE the .pi volume and seeded into
# ${PI_CONFIG_DIR}/agent by the entrypoint on every start — the pi-config named
# volume shadows image content, so these cannot be COPYed directly.
COPY vendor/moody-ai/.pi/prompts/sandy.md /usr/local/pi-dev/moody/prompts/sandy.md
COPY vendor/moody-ai/.pi/prompts/personality-rewrite.md /usr/local/pi-dev/moody/prompts/personality-rewrite.md
COPY vendor/moody-ai/.pi/prompts/summarize-session.md /usr/local/pi-dev/moody/prompts/summarize-session.md
COPY vendor/moody-ai/config/prompts/design-session.md /usr/local/pi-dev/moody/prompts/design-session.md
COPY vendor/moody-ai/config/subagent/APPEND.md /usr/local/pi-dev/moody/subagent/APPEND.md

# Extensions: document-store (the topic tools every moody skill calls), pi-dev-subagent
# (subagent dispatch + the toolCategories mapping in settings.json) and file-size-checker
# (Sandy's quality-control category). Full npm install per extension — identical to
# moody-ai's own image, because the sources value-import typebox/pi-tui devDeps.
# The entrypoint symlinks them into ${PI_CONFIG_DIR}/agent/extensions on every start,
# so the volume never shadows or freezes a stale copy.
COPY vendor/moody-ai/extensions/document-store /usr/local/pi-dev/moody/extensions/document-store
COPY vendor/moody-ai/extensions/pi-dev-subagent /usr/local/pi-dev/moody/extensions/pi-dev-subagent
COPY vendor/moody-ai/extensions/file-size-checker /usr/local/pi-dev/moody/extensions/file-size-checker
RUN --mount=type=secret,id=npmrc,required=false \
    if [ -f /run/secrets/npmrc ]; then export NPM_CONFIG_USERCONFIG=/run/secrets/npmrc; fi \
 && cd /usr/local/pi-dev/moody/extensions/document-store && npm install --legacy-peer-deps --no-audit --no-fund \
 && cd /usr/local/pi-dev/moody/extensions/pi-dev-subagent && npm install --legacy-peer-deps --no-audit --no-fund \
 && cd /usr/local/pi-dev/moody/extensions/file-size-checker && npm install --legacy-peer-deps --no-audit --no-fund

# ── Repo dependency bundles (target-platform node_modules for bind-mounted repos) ──
# Repos are bind-mounted from the host at runtime, and their node_modules were installed
# on the HOST's platform. Native optional deps (@esbuild/*, @rollup/rollup-*,
# lightningcss-*, @tailwindcss/oxide-*, @parcel/watcher-*) are platform-specific, so a
# macOS-installed tree fails deep inside vite/vitest in this linux image.
#
# Per the dq-made-easy-ui AGENTS.md rule ("never copy node_modules across platforms —
# regenerate on the target platform with npm ci"), we do exactly that HERE: the build
# script stages only package.json + package-lock.json from the host checkout into
# docker/pi-dev-agent/repo-deps/ (gitignored; see scripts/build_pi_dev_images.sh), and
# `npm ci` installs everything for THIS image's architecture, reproducibly from the
# lockfile. The entrypoint then merges whatever is missing into the mounted repo's tree
# at startup — additively only, never deleting or overwriting host files.
COPY docker/pi-dev-agent/repo-deps/dq-made-easy-ui/package.json \
     docker/pi-dev-agent/repo-deps/dq-made-easy-ui/package-lock.json \
     /usr/local/pi-dev/repo-deps/dq-made-easy-ui/
RUN --mount=type=secret,id=npmrc,required=false \
    if [ -f /run/secrets/npmrc ]; then export NPM_CONFIG_USERCONFIG=/run/secrets/npmrc; fi && \
    cd /usr/local/pi-dev/repo-deps/dq-made-easy-ui && npm ci --no-audit --no-fund

WORKDIR /workspace/gitrepos

# Only the pi config dir is a volume. /workspace/gitrepos must stay a plain
# directory: repo access comes exclusively from per-repo bind mounts generated
# by scripts/pi_dev_agent.sh, never from an anonymous or host-wide mount.
VOLUME ["/home/app_user/.pi"]

EXPOSE 3000

USER root

ENTRYPOINT ["/usr/local/bin/pi-dev-entrypoint.sh"]
CMD []
