# =============================================================================
# pi-dev — Shared base image for pi-dev containers (moody-ai based)
#
# Source image defaults support local builds. The corporate build script requires
# explicit source images from .env.pi-dev.corporate.
# 
# moody-ai runtime + Python 3.13 (pyenv) + Node.js ${MOODY_NODE_VERSION} + Java ${MOODY_JAVA_VERSION}
# =============================================================================

ARG BUILD_BASE_IMAGE=moody-ai-base:latest
ARG JAVA_SOURCE_IMAGE=eclipse-temurin:25-jdk

# ── Stage 1: moody-ai base image with system packages and Python ───────────────
FROM ${BUILD_BASE_IMAGE} AS base

RUN apt-get -o Acquire::Languages=none update && \
    apt-get install -y --no-install-recommends \
        bash \
        build-essential \
        curl \
        gnupg \
        iptables \
        jq \
        nano \
        openssh-client \
        ripgrep \
        vim-tiny \
        wget \
        xz-utils \
        zsh \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/fdfind /usr/local/bin/fd

# SSL certificate path (moody-ai-base already configured with ca-certificates.crt)
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ENV PIP_CERT=/etc/ssl/certs/ca-certificates.crt
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

# Python 3.13 via pyenv (moody-ai approach)  
ARG MOODY_PYTHON_VERSION=3.13
RUN apt-get -o Acquire::Languages=none update && \
    apt-get install -y --no-install-recommends \
        libicu-dev \
        python${MOODY_PYTHON_VERSION} \
        python${MOODY_PYTHON_VERSION}-venv \
        pyenv

# ── Stage 2: Java runtime (Eclipse Temurin) ──────────────────────────────────
FROM base AS java_runtime
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Copy Java from Temurin image (stage 3 will inherit this)
FROM ${JAVA_SOURCE_IMAGE} AS java_source
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# ── Stage 3: Final image — base + Java from Temurin ───────────────────────────
FROM java_runtime AS final
COPY --from=java_source /opt/java/openjdk/ /opt/java/openjdk/

ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin:${JAVA_HOME}/bin"

# Symlinks & version checks
RUN ln -sf /usr/local/bin/python3 /usr/local/bin/python && \
    ln -sf /usr/local/bin/pip3 /usr/local/bin/pip && \
    node --version && \
    npm --version && \
    python3 --version && \
    java --version

# Nexus registry configuration (optional, via --build-arg)
ARG PIP_INDEX_URL
ARG PIP_EXTRA_INDEX_URL
ARG PIP_TRUSTED_HOST
ARG NEXUSCLOUD_URL
ARG NEXUSCLOUD_USERNAME
ARG NEXUSCLOUD_PASSWORD

RUN if [ -n "$PIP_INDEX_URL" ] && [ -n "$PIP_EXTRA_INDEX_URL" ] && [ -n "$PIP_TRUSTED_HOST" ]; then \
        printf '[global]\nindex-url = %s\nextra-index-url = %s\ntrusted-host = %s\n' \
               "$PIP_INDEX_URL" \
               "$PIP_EXTRA_INDEX_URL" \
               "$PIP_TRUSTED_HOST" > /etc/pip.conf; \
    fi

RUN if [ -n "$NEXUSCLOUD_URL" ]; then \
        base64token=$(echo -n "${NEXUSCLOUD_USERNAME}:${NEXUSCLOUD_PASSWORD}" | base64) && \
        npm config set registry "https://${NEXUSCLOUD_URL}" --global --loglevel verbose && \
        npm config set //$NEXUSCLOUD_URL:_auth=$base64token --global --loglevel verbose && \
        npm config set cafile /etc/ssl/certs/ca-certificates.crt; \
    fi

# Install kubectl
RUN curl -fsLO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" && \
    chmod +x kubectl && \
    mv kubectl /usr/local/bin/kubectl

# Create app_user and workspace directories  
RUN useradd --create-home --shell /bin/bash app_user && \
    mkdir -p /workspace /home/app_user/.pi /home/app_user/.ssh && \
    chown -R app_user:app_user /workspace /home/app_user/.pi /home/app_user/.ssh && \
    chmod 700 /home/app_user/.ssh

WORKDIR /workspace

CMD ["bash"]
