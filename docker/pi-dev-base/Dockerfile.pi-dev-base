# =============================================================================
# pi-dev — Shared base image for pi-dev containers (merged from pi-dev-core)
#
# debian:trixie-slim + Python 3.13 (pyenv) + Node.js 22 + Java 25
# + build tools + kubectl + iptables + jq + zsh
# Root-only — derived images add their own users
# =============================================================================

# ── Stage 1: Base Debian image with tooling ───────────────────────────────────
FROM debian:trixie-slim AS base

ARG DEBIAN_MIRROR=http://ftp.nl.debian.org
RUN if [ -n "$DEBIAN_MIRROR" ]; then \
        sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR}|" /etc/apt/sources.list.d/debian.sources \
        && cat /etc/apt/sources.list.d/debian.sources; \
    fi

RUN rm -f /etc/apt/apt.conf.d/docker-clean

COPY .cache/apt/archives/ /var/cache/apt/archives/

# System packages (merged: core + agent extras)
RUN apt-get -o Acquire::Languages=none update && \
    apt-get install -y --no-install-recommends \
        bash \
        build-essential \
        ca-certificates \
        curl \
        gnupg \
        iptables \
        jq \
        nano \
        openssh-client \
        ripgrep \
        vim-tiny \
        wget \
        xz-utils \
        zsh \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/fdfind /usr/local/bin/fd

# SSL certificate
COPY docker/pi-dev-base/fullchain.pem /usr/local/share/ca-certificates/rabo.crt
RUN update-ca-certificates

ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ENV PIP_CERT=/etc/ssl/certs/ca-certificates.crt
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

# Python 3.13 via pyenv (pi-dev-core approach)
RUN apt-get -o Acquire::Languages=none update && \
    apt-get install -y --no-install-recommends \
        libicu-dev \
        python3.13 \
        python3.13-venv \
        pyenv

# ── Stage 2: Node.js 22 (from official image) ────────────────────────────────
FROM node:22-bookworm-slim AS node_runtime

# ── Stage 3: Java runtime (Eclipse Temurin) ───────────────────────────────────
FROM eclipse-temurin:25-jdk AS java_runtime
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# ── Stage 4: Final image — base + Node.js + Java ─────────────────────────────
FROM base

COPY --from=node_runtime /usr/local/ /usr/local/
COPY --from=java_runtime /opt/java/openjdk/ /opt/java/openjdk/

ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin:${JAVA_HOME}/bin"

# Symlinks & version checks
RUN ln -sf /usr/local/bin/python3 /usr/local/bin/python && \
    ln -sf /usr/local/bin/pip3 /usr/local/bin/pip && \
    node --version && \
    npm --version && \
    python3 --version && \
    java --version

# Nexus registry configuration (optional, via --build-arg)
ARG PIP_INDEX_URL
ARG PIP_EXTRA_INDEX_URL
ARG PIP_TRUSTED_HOST
ARG NEXUSCLOUD_URL
ARG NEXUSCLOUD_USERNAME
ARG NEXUSCLOUD_PASSWORD

RUN if [ -n "$PIP_INDEX_URL" ] && [ -n "$PIP_EXTRA_INDEX_URL" ] && [ -n "$PIP_TRUSTED_HOST" ]; then \
        printf '[global]\nindex-url = %s\nextra-index-url = %s\ntrusted-host = %s\n' \
               "$PIP_INDEX_URL" \
               "$PIP_EXTRA_INDEX_URL" \
               "$PIP_TRUSTED_HOST" > /etc/pip.conf; \
    fi

RUN if [ -n "$NEXUSCLOUD_URL" ]; then \
        base64token=$(echo -n "${NEXUSCLOUD_USERNAME}:${NEXUSCLOUD_PASSWORD}" | base64) && \
        npm config set registry "https://${NEXUSCLOUD_URL}" --global --loglevel verbose && \
        npm config set //$NEXUSCLOUD_URL:_auth=$base64token --global --loglevel verbose && \
        npm config set cafile /etc/ssl/certs/ca-certificates.crt; \
    fi

# Install kubectl
RUN curl -fsLO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" && \
    chmod +x kubectl && \
    mv kubectl /usr/local/bin/kubectl

# Create app_user and workspace directories
RUN useradd --create-home --shell /bin/bash app_user && \
    mkdir -p /workspace /home/app_user/.pi /home/app_user/.ssh && \
    chown -R app_user:app_user /workspace /home/app_user/.pi /home/app_user/.ssh && \
    chmod 700 /home/app_user/.ssh

WORKDIR /workspace

CMD ["bash"]
