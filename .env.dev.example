# Dev environment for building and running the pi-dev agent (local machine).
# Copy to .env.dev; see docs/infra/PI_DEV_AGENT_IMAGE.md.

# Build settings (local source defaults).
# Build from moody-ai sources separately using that project's own instructions.
# Load/tag the resulting image locally before building pi-dev images.
BUILD_BASE_IMAGE=moody-ai-base:latest
JAVA_SOURCE_IMAGE=eclipse-temurin:25-jdk
BUILDKIT_SYNTAX=docker/dockerfile:1.7
MOODY_NODE_VERSION=22
MOODY_JAVA_VERSION=25
SSL_CERT_PATH=/etc/ssl/certs/ca-certificates.crt

PI_DEV_BASE_IMAGE_NAME=platform-pi-dev-base
PI_DEV_AGENT_IMAGE_NAME=platform-pi-dev-agent
PI_DEV_IMAGE_TAG=latest
PI_CODING_AGENT_VERSION=latest

# Runtime settings.
# Required host repository bind mount; replace before starting.
GITREPOS_HOST_PATH=/absolute/path/to/gitrepos
# Pi config uses the private pi-config Docker volume, not the host ~/.pi.

# REQUIRED: comma-separated relative repo paths under GITREPOS_HOST_PATH.
# Only these repos are mounted into the container; mounting the whole
# GITREPOS_HOST_PATH directory is not allowed (start fails without this).
# Never include pi-dev-agent itself: it must not be available inside its own container.
# GITREPOS_ALLOWLIST=repo-one,repo-two

# Dedicated host SSH private key only; never mount your entire ~/.ssh.
# Compose defaults to $HOME/.ssh/pi-dev-agent_host even when unset.
# Create the key before starting; only its public key belongs on the SSH server.
# HOST_SSH_KEY_PATH=/absolute/path/to/dedicated-host-key

# Optional host bin directory mounted onto /home/app_user/bin inside the
# container. Set this when you want host scripts such as ssh-llm available
# on PATH from inside pi-dev-agent.
# HOST_BIN_DIR_HOST_PATH=/absolute/path/to/bin

# Optional host SSH alias inside the container.
# When both values are set, the container writes a Host block that points at
# HOST_SSH_HOSTNAME so commands like `ssh pidev` can reach the Docker host.
# HOST_SSH_ALIAS=pidev
# HOST_SSH_USER=pidev
# HOST_SSH_HOSTNAME=host.docker.internal
# HOST_SSH_PORT=22

# Llama.cpp server URL for the optional pi-llama-cpp extension inside the
# container. This should point at the host-forwarded port, not container loopback.
# PI_DEV_AGENT_LLAMA_SERVER_URL=http://localhost:8082

# Optional direct outbound exceptions under strict egress enforcement.
# Most internet traffic should stay proxied. Use this only for destinations that
# must remain directly reachable, for example host SSH.
# PI_DEV_AGENT_DIRECT_ALLOW_HOSTS=host.docker.internal:22

# Optional HTTP proxy settings for the pi-dev agent sidecar proxy.
# The blocked hostname/domain list lives in docker/pi-dev-agent/proxy/blocked_domains.txt.
# This is the Compose default. NO_PROXY only bypasses the proxy; it does not
# grant direct egress. Non-loopback access also needs an explicit direct rule.
# Do not add broad .dev.jac.dot exceptions: WeKan must remain proxied.
# PI_DEV_AGENT_NO_PROXY=localhost,127.0.0.1,host.docker.internal,192.168.65.254,192.168.65.254:8082,.local,.svc,.svc.cluster.local

# Optional port override for the pi HTTP interface.
# PI_DEV_AGENT_PORT=3000

# Optional runtime credentials for the existing jacloud.site PyPI index only.
# Both must be set for the entrypoint to write /etc/pip.conf; not build inputs.
# PYPI_USERNAME=
# PYPI_PASSWORD=

# Fallback host npmrc path; local-only proxy/npmrc is preferred when present.
# NPM_CONFIG_FILE=
# Fallback host pip config path; local-only proxy/pip.conf is preferred when present.
# PIP_CONFIG_FILE="$HOME/pip.conf"

# LLM tunnel sidecars (docker-compose/pi-dev-agent.yml): ssh targets and port
# forwards for the tunnel-local / tunnel-ai containers. Replace targets with your own hosts.
TUNNEL_LOCAL_LLM_TARGET="user@192.0.2.1" # replace: user@host of the local machine
TUNNEL_LOCAL_LLM_FORWARDS="-L 0.0.0.0:8082:localhost:1234"
TUNNEL_MINI_AI_TARGET="user@192.0.2.2" # replace: user@host of the mini-ai machine
TUNNEL_MINI_AI_FORWARDS="-L 0.0.0.0:1234:localhost:1234 -L 0.0.0.0:1235:localhost:8083"
